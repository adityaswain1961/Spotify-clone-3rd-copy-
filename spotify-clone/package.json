{
  "name": "@spotify-clone/source",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "nx run-many --target=serve --parallel=10 --projects=api-gateway,auth-service,media-service,search-service,playlist-service,recommendation-service,interaction-service,notification-service",
    "dev:all": "pnpm dev",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "db:generate": "prisma generate --schema libs/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema libs/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema libs/prisma/schema.prisma",
    "db:studio": "prisma studio --schema libs/prisma/schema.prisma",
    "db:seed": "node -r @swc-node/register scripts/seed.ts",
    "setup": "pnpm install && pnpm db:migrate:deploy && pnpm db:seed && pnpm mobile:install",
    "mobile": "npm --prefix mobile-app start",
    "mobile:install": "npm --prefix mobile-app install",
    "mobile:typecheck": "npm --prefix mobile-app run typecheck"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1044.0",
    "@aws-sdk/cloudfront-signer": "^3.1036.0",
    "@aws-sdk/s3-request-presigner": "^3.1044.0",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/terminus": "^11.1.1",
    "@opentelemetry/auto-instrumentations-node": "^0.75.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.217.0",
    "@opentelemetry/sdk-node": "^0.217.0",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.76.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "ffmpeg-static": "^5.3.0",
    "firebase-admin": "^12.7.0",
    "http-proxy-middleware": "^4.0.0",
    "ioredis": "^5.10.1",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nx/js": "22.7.1",
    "@nx/workspace": "22.7.1",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.22",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "nx": "22.7.1",
    "prettier": "^3.6.2",
    "prisma": "^5.22.0",
    "typescript": "^5.9.3"
  }
}
