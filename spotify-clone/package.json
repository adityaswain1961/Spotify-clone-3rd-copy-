{
  "name": "@spotify-clone/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev:all": "nx run-many --projects=api-gateway,auth-service,media-service,search-service,playlist-service,recommendation-service,interaction-service,notification-service --target=serve --parallel",
    "docker:up": "docker compose up -d",
    "db:migrate:deploy": "prisma migrate deploy --schema libs/prisma/schema.prisma",
    "db:migrate:reset-failed": "prisma migrate resolve --rolled-back 20260508180200_fts_triggers --schema libs/prisma/schema.prisma",
    "db:push": "prisma db push --schema libs/prisma/schema.prisma",
    "mobile:start": "nx run mobile-app:start",
    "mobile:android": "nx run mobile-app:android",
    "db:migrate": "prisma migrate dev --schema libs/prisma/schema.prisma",
    "db:studio": "prisma studio --schema libs/prisma/schema.prisma"
  },
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "bcrypt", "@prisma/client", "@prisma/engines", "prisma", "nx"]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1044.0",
    "@aws-sdk/cloudfront-signer": "^3.1036.0",
    "@aws-sdk/s3-request-presigner": "^3.1044.0",
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/terminus": "^10.3.0",
    "@nestjs/throttler": "^6.5.0",
    "@opentelemetry/auto-instrumentations-node": "^0.75.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.217.0",
    "@opentelemetry/sdk-node": "^0.217.0",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.76.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "firebase-admin": "^12.7.0",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "http-proxy-middleware": "^4.0.0",
    "ioredis": "^5.10.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nx/eslint-plugin": "^22.7.1",
    "@nx/js": "22.7.1",
    "@nx/workspace": "22.7.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^25.6.0",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^9.36.0",
    "nx": "22.7.1",
    "prettier": "^3.6.2",
    "prisma": "^5.22.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3"
  }
}
