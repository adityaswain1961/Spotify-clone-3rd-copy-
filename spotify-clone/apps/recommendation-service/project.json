{
  "name": "recommendation-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/recommendation-service/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/recommendation-service",
        "main": "apps/recommendation-service/src/main.ts",
        "tsConfig": "apps/recommendation-service/tsconfig.app.json",
        "assets": []
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --watch --watch-preserve-output -r @swc-node/register apps/recommendation-service/src/main.ts",
        "cwd": "{workspaceRoot}"
      }
    }
  },
  "tags": []
}
