# Copy to .env (git-ignored). Every service loads it automatically on start.

# ── Core infrastructure (docker compose up -d) ──────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spotify?schema=public
REDIS_URL=redis://localhost:6379

# ── Secrets: replace both with long random strings (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=change-me-access-secret
# Shared by the gateway and internal services; services reject requests without it.
SERVICE_API_KEY=change-me-service-key

# ── Tokens ──────────────────────────────────────────────────────────────────
ACCESS_TOKEN_TTL_SECONDS=900
# Long-lived so people listening offline are not signed out.
REFRESH_TOKEN_TTL_DAYS=30

# ── Media storage ───────────────────────────────────────────────────────────
# local: files on disk under STORAGE_LOCAL_DIR, served via the gateway (zero setup).
# s3:    AWS S3 (optionally fronted by CloudFront) or any S3-compatible store.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage
# Signs local media URLs. Defaults to SERVICE_API_KEY when unset.
# STORAGE_SIGNING_SECRET=
STREAM_URL_TTL_SECONDS=21600
DOWNLOAD_URL_TTL_SECONDS=1800
MAX_UPLOAD_MB=200
TRANSCODE_CONCURRENCY=2
# Absolute base for cover images (CDN / bucket). Unset = served through the gateway.
# ASSETS_BASE_URL=https://cdn.example.com

# S3 driver only
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_UPLOAD_BUCKET=spotify-uploads
# S3_MEDIA_BUCKET=spotify-media
# S3_ENDPOINT=                 # e.g. http://localhost:9000 for MinIO
# S3_PUBLIC_ENDPOINT=          # host the phone can reach, if different from S3_ENDPOINT
# CloudFront signing for media (optional; falls back to S3 presigned URLs)
# CLOUDFRONT_DOMAIN=d111111abcdef8.cloudfront.net
# CLOUDFRONT_KEY_PAIR_ID=
# CLOUDFRONT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# ── Gateway ─────────────────────────────────────────────────────────────────
API_GATEWAY_PORT=3000
RATE_LIMIT_PER_MINUTE=600
AUTH_RATE_LIMIT_PER_MINUTE=20
# Comma-separated browser origins; unset = reflect any origin (fine for native apps / dev).
# ALLOWED_ORIGINS=
# TRUST_PROXY=1
# Service locations (defaults: 127.0.0.1:3001..3007)
# AUTH_SERVICE_URL=http://127.0.0.1:3001
# MEDIA_SERVICE_URL=http://127.0.0.1:3003
# PLAYLIST_SERVICE_URL=http://127.0.0.1:3004
# INTERACTION_SERVICE_URL=http://127.0.0.1:3005
# SEARCH_SERVICE_URL=http://127.0.0.1:3006
# RECOMMENDATION_SERVICE_URL=http://127.0.0.1:3007

# ── Optional ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FFMPEG_PATH=/usr/bin/ffmpeg
