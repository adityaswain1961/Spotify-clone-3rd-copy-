{
  "compileOnSave": false,
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "sourceMap": true,
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@spotify/env": ["libs/common/src/config/load-env.ts"],
      "@spotify/common": ["libs/common/src/index.ts"],
      "@spotify/prisma": ["libs/prisma/src/index.ts"],
      "@spotify/bull-config": ["libs/bull-config/src/index.ts"],
      "@spotify/media": ["libs/media/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp", "mobile-app"]
}
